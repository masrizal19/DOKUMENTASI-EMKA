# Konfigurasi Upload Berkas Galeri EMKA
# Letakkan di direktori backend API PHP (misal /api/ atau root public_html)

<IfModule mod_php.c>
    php_value upload_max_filesize 2G
    php_value post_max_size 2G
    php_value max_execution_time 3600
    php_value max_input_time 3600
    php_value memory_limit 512M
</IfModule>

<IfModule mod_php7.c>
    php_value upload_max_filesize 2G
    php_value post_max_size 2G
    php_value max_execution_time 3600
    php_value max_input_time 3600
    php_value memory_limit 512M
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 2G
    php_value post_max_size 2G
    php_value max_execution_time 3600
    php_value max_input_time 3600
    php_value memory_limit 512M
</IfModule>
