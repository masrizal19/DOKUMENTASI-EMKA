# Konfigurasi Upload & HTTP Method Galeri EMKA API
# Letakkan di direktori backend API PHP (misal /api/ atau root public_html)

# Izinkan method HTTP standar untuk REST API
<Limit GET POST PUT DELETE OPTIONS>
    Allow from all
</Limit>

# Pastikan Authorization header diteruskan ke skrip PHP di bawah mod_rewrite / fastcgi
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
</IfModule>

# Konfigurasi Header CORS untuk file statis / gambar (PNG, JPG, WebP, dll.)
<IfModule mod_headers.c>
    SetEnvIf Origin "^(https?://(.*\.)?mkverse\.my\.id(:[0-9]+)?|http://localhost(:[0-9]+)?)$" CORS_ALLOW_ORIGIN=$0
    <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|bmp)$">
        Header set Access-Control-Allow-Origin "https://galerifoto.mkverse.my.id"
        Header append Access-Control-Allow-Origin "https://galeri.mkverse.my.id"
        Header append Access-Control-Allow-Origin "https://api.mkverse.my.id"
        Header set Access-Control-Allow-Methods "GET, OPTIONS"
        Header set Access-Control-Allow-Headers "*"
        Header set Access-Control-Allow-Credentials "true"
        Header set Access-Control-Max-Age "86400"
    </FilesMatch>
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 2G
    php_value post_max_size 2G
    php_value max_execution_time 3600
    php_value max_input_time 3600
    php_value memory_limit 512M
</IfModule>

<IfModule mod_php7.c>
    php_value upload_max_filesize 2G
    php_value post_max_size 2G
    php_value max_execution_time 3600
    php_value max_input_time 3600
    php_value memory_limit 512M
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 2G
    php_value post_max_size 2G
    php_value max_execution_time 3600
    php_value max_input_time 3600
    php_value memory_limit 512M
</IfModule>
